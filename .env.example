# Copy to .env and fill in your credentials
SYMBOL=XAUUSD
MODE=demo

# Risk
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_RISK=5
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=50

# News filter
NEWS_MODE=OFF
NEWS_CURRENCY=USD
NEWS_BLACKOUT_BEFORE_MINUTES=30
NEWS_BLACKOUT_AFTER_MINUTES=30
NEWS_FAIL_CLOSED=true
NEWS_DEMO_EVENTS=true
NEWS_FETCH_INTERVAL_SECONDS=300

# Telegram
TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# MT5
MT5_SERVER=ICMarkets-Demo
MT5_LOGIN=0
MT5_PASSWORD=

# Execution
MAX_SPREAD_POINTS=200
DEVIATION=20
MAGIC=123456
HOLD_SECONDS=90
ANALYSIS_INTERVAL_SECONDS=60

